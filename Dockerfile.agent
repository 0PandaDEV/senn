FROM rust:1-bookworm AS build
WORKDIR /app
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY server ./server
COPY shared ./shared
COPY agent ./agent
COPY migrations ./migrations
RUN mkdir -p public && cargo build --release --no-default-features --features agent --bin senn-agent

FROM scratch AS out
COPY --from=build /app/target/release/senn-agent /senn-agent
